# ApexPay Security Operations Configuration

# The live ingestion endpoint of your Flare instance (exposed via ngrok or direct URL)
# Example: https://abc-123.ngrok-free.app/api/v1/ingest/eve
FLARE_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/ingest/eve

# Flare Ingest Service Token (generated from Flare backend .env INGEST_SERVICE_TOKEN)
FLARE_SERVICE_TOKEN=your_flare_ingest_service_token_here

# Server Port (optional, defaults to 5000)
PORT=5000
