{
  "name": "apexpay",
  "version": "1.0.0",
  "description": "ApexPay - Modern Fintech Banking Platform with SOC Telemetry",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "client": "vite --host",
    "server": "node server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:attacks": "python scripts/attack_tester.py http://localhost:3000"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^4.0.0",
    "vite": "^6.2.0"
  }
}
